---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	// A local image (e.g. a post's cover), a path in public/ or a remote image URL (e.g. a stock
	// photo chosen in the writing panel), used as it is
	image?: ImageMetadata | string;
	author?: string;
	/** Set on articles: marks the page as an article for social previews and search engines */
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	/** Language of the page content, e.g. "it" */
	lang?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/social-default.jpg',
	author,
	publishedTime,
	modifiedTime,
	tags = [],
	lang = 'en',
} = Astro.props;

// Social previews: cover images are cropped to the recommended 1200x630 and saved as JPG,
// which every platform (Facebook, WhatsApp, X, Telegram...) can display
const socialImage =
	typeof image === 'string'
		? { src: image, width: undefined, height: undefined }
		: await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' }).then(
				(img) => ({ src: img.src, width: 1200, height: 630 }),
			);
const socialImageURL = new URL(socialImage.src, Astro.url);
const locale = { it: 'it_IT', en: 'en_US' }[lang] ?? lang;

// Structured data (schema.org JSON-LD): lets search engines understand the page —
// an article with its dates, author and image, or the website itself on other pages
const homeURL = new URL('/', Astro.site).href;
const structuredData = publishedTime
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			image: socialImageURL.href,
			datePublished: publishedTime.toISOString(),
			dateModified: (modifiedTime ?? publishedTime).toISOString(),
			inLanguage: lang,
			url: canonicalURL.href,
			mainEntityOfPage: canonicalURL.href,
			keywords: tags.length ? tags.join(', ') : undefined,
			author: author ? { '@type': 'Person', name: author } : { '@type': 'Organization', name: SITE_TITLE, url: homeURL },
			publisher: { '@type': 'Organization', name: SITE_TITLE, url: homeURL },
		}
	: { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_TITLE, url: homeURL };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<!-- Apply the theme before the page is painted (no flash of the wrong theme):
     the visitor's saved choice if any, otherwise the device setting -->
<script is:inline>
	(() => {
		const media = matchMedia('(prefers-color-scheme: dark)');
		const saved = () => {
			try {
				return localStorage.getItem('theme');
			} catch {
				return null;
			}
		};
		const apply = () => {
			const theme = saved();
			document.documentElement.dataset.theme =
				theme === 'dark' || theme === 'light' ? theme : media.matches ? 'dark' : 'light';
			syncThemeColor();
		};
		const syncThemeColor = () => {
			const meta = document.querySelector('meta[name="theme-color"]');
			if (meta) meta.content = document.documentElement.dataset.theme === 'dark' ? '#161616' : '#ffffff';
		};
		// The <meta> is further down in <head>: sync once it exists, then follow the theme toggle
		document.addEventListener('DOMContentLoaded', syncThemeColor);
		new MutationObserver(syncThemeColor).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
		apply();
		media.addEventListener('change', apply);
	})();
	// Page transitions: if a cover image taking part in the transition hasn't loaded yet,
	// leave it out (plain cross-fade) instead of animating an empty box
	addEventListener('pagereveal', (event) => {
		if (!event.viewTransition) return;
		for (const img of document.querySelectorAll('img[style*="view-transition-name"]')) {
			if (!img.complete || !img.naturalWidth) img.style.viewTransitionName = 'none';
		}
	});
</script>
<!-- Chrome/Edge: start loading an article (and its cover) while the pointer rests on its link,
     so the page and the cover transition are ready on click. Other browsers ignore this. -->
<script type="speculationrules">
	{
		"prerender": [{ "where": { "href_matches": "/blog/*" }, "eagerness": "moderate" }]
	}
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<!-- Browser bar color on phones; kept in sync with the theme by the script below -->
<meta name="theme-color" content="#ffffff" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{author && <meta name="author" content={author} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={locale} />
{
	publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{publishedTime && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
{socialImage.width && <meta property="og:image:width" content={String(socialImage.width)} />}
{socialImage.height && <meta property="og:image:height" content={String(socialImage.height)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
