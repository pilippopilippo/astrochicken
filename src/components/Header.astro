---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import { SITE_TITLE } from '../consts';
---

<a class="skip-link" href="#main">Skip to content</a>
<!-- The site interface is in English even on pages written in another language -->
<header lang="en">
	<nav aria-label="Main">
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<button
			type="button"
			class="menu-toggle"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="site-menu"
		>
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
		<div class="internal-links" id="site-menu">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/about">About me</HeaderLink>
		</div>
		<div class="actions">
			<Search />
			<ThemeToggle />
		</div>
	</nav>
</header>

<script>
	// On narrow screens the links collapse into a hamburger menu.
	// Without JavaScript the class below is never added and the links stay visible.
	const header = document.querySelector('header');
	const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
	const menu = header?.querySelector<HTMLElement>('.internal-links');

	if (header && toggle && menu) {
		header.classList.add('has-menu');

		const setOpen = (open: boolean) => {
			header.classList.toggle('menu-open', open);
			toggle.setAttribute('aria-expanded', String(open));
		};
		const isOpen = () => header.classList.contains('menu-open');

		toggle.addEventListener('click', () => setOpen(!isOpen()));
		menu.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) setOpen(false);
		});
		document.addEventListener('click', (event) => {
			if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) {
				setOpen(false);
				toggle.focus();
			}
		});
	}
</script>

<style>
	/* Hidden until focused with the keyboard (Tab), then shown above the header */
	.skip-link {
		position: absolute;
		top: 0.5em;
		left: 0.5em;
		z-index: 30;
		padding: 0.5em 1em;
		color: var(--on-accent);
		background: var(--accent-text);
		border-radius: 8px;
		text-decoration: none;
		transform: translateY(-200%);
	}
	.skip-link:focus {
		transform: none;
	}
	header {
		/* Kept out of the page cross-fade so it doesn't flicker when navigating */
		view-transition-name: site-header;
		position: relative;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: 0 2px 8px rgba(var(--shadow), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	h2 {
		grid-column: 1;
		grid-row: 1;
	}
	.internal-links {
		grid-column: 2;
		grid-row: 1;
	}
	.actions {
		grid-column: 3;
		grid-row: 1;
		justify-self: end;
		display: flex;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: inherit;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.menu-toggle {
		display: none;
	}

	@media (max-width: 720px) {
		.has-menu nav {
			grid-template-columns: 1fr auto auto;
		}
		.has-menu .actions {
			grid-column: 2;
		}
		.has-menu .menu-toggle {
			grid-column: 3;
			grid-row: 1;
		}
		.has-menu h2 {
			padding: 1em 0;
		}
		.has-menu .menu-toggle {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 44px;
			height: 44px;
			padding: 10px;
			background: none;
			border: none;
			border-radius: 8px;
			cursor: pointer;
		}
		.menu-toggle:focus-visible {
			outline: 2px solid var(--accent);
		}
		.bar {
			display: block;
			height: 2px;
			background: rgb(var(--black));
			border-radius: 2px;
			transition:
				transform 0.2s ease,
				opacity 0.2s ease;
		}
		/* The three bars turn into an X while the menu is open */
		.menu-open .bar:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}
		.menu-open .bar:nth-child(2) {
			opacity: 0;
		}
		.menu-open .bar:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}

		.has-menu .internal-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			padding: 0.5em 0;
			background: var(--surface);
			box-shadow: 0 8px 16px rgba(var(--shadow), 8%);
		}
		.menu-open .internal-links {
			display: flex;
		}
		.has-menu .internal-links a {
			padding: 0.75em 1.5em;
			border-bottom: none;
			border-left: 4px solid transparent;
		}
		.has-menu .internal-links a.active {
			border-left-color: var(--accent);
		}
	}
</style>
